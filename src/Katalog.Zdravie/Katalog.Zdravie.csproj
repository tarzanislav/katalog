<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small helper that reads disk health (SMART) with administrator rights, only on request (stage E5).
       It depends on nothing, writes only numbers as JSON to its output and never touches the library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Katalog.Zdravie</AssemblyName>
    <RootNamespace>Katalog.Zdravie</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
