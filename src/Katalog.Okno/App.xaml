<Application x:Class="Katalog.Okno.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Ikony">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolNaViditelnost" />

            <!-- the tints of the blocks of the main window (owner, 8. 11. 2026): see-through, so they suit the light and the
                 dark theme alike – the menu bluish, the detail of a title warm, the library without a tint -->
            <!-- pastel tints over the window's background: light pastel in the light theme, a quiet tint in the dark one -->
            <SolidColorBrush x:Key="FarbaMenu" Color="#262F6FD6" />
            <SolidColorBrush x:Key="FarbaDiskov" Color="#2E3BAE7A" />
            <SolidColorBrush x:Key="FarbaDetailu" Color="#1CE09A2E" />
            <SolidColorBrush x:Key="FarbaBlokuDetailu" Color="#16808080" />
            <!-- a collection as the lists of UNIVERSUM: a peach block with an orange edge and heading -->
            <SolidColorBrush x:Key="FarbaKolekcie" Color="#24F08A3C" />
            <SolidColorBrush x:Key="FarbaKolekcieOkraj" Color="#E8833A" />

            <!-- section names in the left panel (KNIŽNICA, DISKY, ZBIERKY) -->
            <Style x:Key="NadpisSekcie" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="12,12,12,4" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <!-- a heading of a part of the title's card (Identifikátory, Kolekcia …) -->
            <Style x:Key="NadpisKarty" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="PolozkaNavigacie" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <!-- text that looks like a label but can be selected and copied -->
            <Style x:Key="TextNaKopirovanie" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TichyText" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
