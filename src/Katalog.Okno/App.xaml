<Application x:Class="Katalog.Okno.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Ikony">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- section names in the left panel (KNIŽNICA, DISKY, ZBIERKY) -->
            <Style x:Key="NadpisSekcie" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="12,16,12,4" />
                <Setter Property="Opacity" Value="0.7" />
            </Style>

            <Style x:Key="PolozkaNavigacie" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="12,6" />
            </Style>

            <Style x:Key="TichyText" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
