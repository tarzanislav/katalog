<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window of KATALOG (WPF). It only shows and asks: rules live in the core, data in Katalog.Data. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Katalog</AssemblyName>
    <RootNamespace>Katalog.Okno</RootNamespace>
    <Description>KATALOG – súkromný katalóg videotéky a diskov</Description>
    <SatelliteResourceLanguages>sk</SatelliteResourceLanguages>
    <!-- WPF0001: ThemeMode (Fluent, light and dark) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- drawn by tools/ikona/vytvor_ikonu.py -->
    <ApplicationIcon>Zdroje\katalog.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Zdroje\katalog.ico" />
    <Resource Include="Zdroje\katalog-256.png" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Katalog.Jadro\Katalog.Jadro.csproj" />
    <ProjectReference Include="..\Katalog.Data\Katalog.Data.csproj" />
    <ProjectReference Include="..\Katalog.Skenovanie\Katalog.Skenovanie.csproj" />
    <ProjectReference Include="..\Katalog.Media\Katalog.Media.csproj" />
    <ProjectReference Include="..\Katalog.Zdroje\Katalog.Zdroje.csproj" />
    <ProjectReference Include="..\Katalog.Ulohy\Katalog.Ulohy.csproj" />
    <ProjectReference Include="..\Katalog.Vystupy\Katalog.Vystupy.csproj" />
  </ItemGroup>
</Project>
