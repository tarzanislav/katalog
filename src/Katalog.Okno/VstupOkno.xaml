<Window x:Class="Katalog.Okno.VstupOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Zdroje/katalog.ico"
        SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Otazka" TextWrapping="Wrap" />
        <TextBox x:Name="Text" Margin="0,8,0,0" Padding="8,5" />
        <TextBlock x:Name="Chyba" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#C42B1C" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Padding="20,6" MinWidth="80" Click="Ok_Click" />
            <Button Content="Zrušiť" IsCancel="True" Padding="20,6" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
