<Window x:Class="Katalog.Okno.UpravDiskOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upraviť disk"
        Icon="Zdroje/katalog.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Názov" VerticalAlignment="Center" />
            <TextBox x:Name="Nazov" Grid.Column="1" Padding="8,5" />
            <TextBlock Grid.Row="1" Text="Číslo na štítku" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="Cislo" Grid.Row="1" Grid.Column="1" Padding="8,5" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="2" Text="Katalóg" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox x:Name="Katalogy" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" DisplayMemberPath="Nazov" />
            <TextBlock Grid.Row="3" Text="Kde leží" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="Umiestnenie" Grid.Row="3" Grid.Column="1" Padding="8,5" Margin="0,8,0,0"
                     ToolTip="Napríklad: polica v obývačke, krabica 2" />
            <TextBlock Grid.Row="4" Text="Poznámka" Margin="0,14,0,0" />
            <TextBox x:Name="Poznamka" Grid.Row="4" Grid.Column="1" Padding="8,5" Margin="0,8,0,0" Height="64"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
        </Grid>
        <CheckBox x:Name="Nahlady" Margin="0,12,0,0" Content="Robiť náhľady videí z tohto disku (asi 15 kB na video, vedľa knižnice)" />
        <TextBlock Margin="24,2,0,0" TextWrapping="Wrap" Style="{StaticResource TichyText}"
                   Text="Na pomalých USB a sieťových diskoch zaberú čas; technické údaje sa čítajú aj bez nich." />
        <TextBlock x:Name="Chyba" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C42B1C" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Uložiť" IsDefault="True" Padding="20,6" MinWidth="80" Click="Ulozit_Click" />
            <Button Content="Zrušiť" IsCancel="True" Padding="20,6" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
