<Window x:Class="Katalog.Okno.StitkyOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Štítky"
        Icon="Zdroje/katalog.ico"
        Width="1040" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel Margin="20,16,16,16">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <Button x:Name="TlacidloTlacit" Padding="14,6" HorizontalAlignment="Stretch" Click="Tlacit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                            <TextBlock Text="Tlačiť…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TlacidloPdf" Padding="14,6" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="UlozitPdf_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA90;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                            <TextBlock Text="Uložiť ako PDF…" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="Zavrieť" IsCancel="True" Padding="14,6" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="Zavriet_Click" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="Nadpis" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="Popis" Margin="0,4,0,0" Style="{StaticResource TichyText}" />

                        <TextBlock Text="Formát" Margin="0,16,0,4" FontWeight="SemiBold" />
                        <ComboBox x:Name="Sablona" DisplayMemberPath="Nazov" SelectionChanged="Volba_Changed" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Začať od štítku" Margin="0,0,0,4" />
                                <ComboBox x:Name="ZacatOd" SelectionChanged="Volba_Changed"
                                          ToolTip="Na načatom hárku: prvý voľný štítok (zľava doprava, zhora nadol)" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kópie" Margin="0,0,0,4" />
                                <ComboBox x:Name="Kopie" SelectionChanged="Volba_Changed" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="Qr" Content="QR kód" Margin="0,14,0,0" Checked="Volba_Changed" Unchecked="Volba_Changed"
                                  ToolTip="Mobil po načítaní ukáže číslo a názov disku či titulu" />
                        <CheckBox x:Name="Ramcek" Content="Rámček na strihanie" Margin="0,8,0,0" Checked="Volba_Changed" Unchecked="Volba_Changed"
                                  ToolTip="Pre obyčajný papier namiesto samolepiacich štítkov" />

                        <TextBlock Text="Posun tlače (mm)" Margin="0,16,0,4" FontWeight="SemiBold" />
                        <TextBlock Text="Keď tlačiareň netrafí štítky presne: kladné číslo posunie tlač doprava a nadol."
                                   Style="{StaticResource TichyText}" FontSize="12" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" x:Name="PosunX" Padding="6,4" TextChanged="Posun_TextChanged" />
                            <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="4" x:Name="PosunY" Padding="6,4" TextChanged="Posun_TextChanged" />
                        </Grid>
                        <TextBlock x:Name="Sprava" Margin="0,16,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox Margin="24" Stretch="Uniform" StretchDirection="Both">
                <Border BorderThickness="1" BorderBrush="#40000000">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                    </Border.Effect>
                    <Image x:Name="Nahlad" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Viewbox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Button x:Name="Predosla" Padding="10,4" Click="Predosla_Click" ToolTip="Predošlá strana">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource Ikony}" />
                </Button>
                <TextBlock x:Name="CisloStrany" Margin="14,0" VerticalAlignment="Center" MinWidth="110" TextAlignment="Center" />
                <Button x:Name="Dalsia" Padding="10,4" Click="Dalsia_Click" ToolTip="Ďalšia strana">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Ikony}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
