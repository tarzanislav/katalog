<Window x:Class="Katalog.Okno.HlavneOkno"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Katalog.Okno"
        Title="KATALOG"
        Icon="Zdroje/katalog.ico"
        Width="1280" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar: search is the main entry into the program -->
        <Grid Grid.Row="0" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="640" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="PoleHladania" VerticalContentAlignment="Center" Padding="10,6"
                         TextChanged="PoleHladania_TextChanged" PreviewKeyDown="PoleHladania_PreviewKeyDown"
                         ToolTipService.ShowDuration="60000">
                    <TextBox.ToolTip>
                        <TextBlock xml:space="preserve" FontFamily="Consolas" FontSize="12">Slová: časti názvov súborov a priečinkov (bez ohľadu na diakritiku)
"presná fráza"   -bez tohto slova
pripona:mkv,mp4      typ:video | titulky | zvuk | obrazok | priecinok | subor
velkost:>4GB         velkost:1GB..8GB
zmenene:2024         zmenene:>=2024-05      pridane:7d
disk:3   disk:"Názov disku"   katalog:Videotéka
pripojene:ano        zmazane:aj | len
kvalita:4k | >=fhd   kodek:hevc   hdr:ano | dv   dlzka:>2h
zvuk:sk,cs           titulky:sk | ano | nie      poskodene:ano
rok:2001   zaner:komedia   herec:"Meno"   kniznica:film | serial | potvrdit   videne:nie
verzie:>1   zalohovane:nie   duplikat:ano   pozicane:ano | Meno   stitok:Vianoce
Enter hľadá hneď, Esc hľadanie zruší.</TextBlock>
                    </TextBox.ToolTip>
                </TextBox>
                <TextBlock x:Name="NapovedaHladania" Text="Hľadať, napr. šťastný film typ:video"
                           Margin="14,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button Grid.Column="1" x:Name="TlacidloFiltre" Content="Filtre" Margin="8,0,0,0" Padding="14,6" Click="Filtre_Click"
                    ToolTip="Typ, veľkosť, dátum, disk, katalóg – zapíšu sa do poľa hľadania" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <RadioButton x:Name="ZobrazeniePlagaty" Content="Plagáty" GroupName="Zobrazenie" IsChecked="True"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" />
                <RadioButton x:Name="ZobrazenieZoznam" Content="Zoznam" GroupName="Zobrazenie"
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="14,6" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button x:Name="TlacidloNastavenia" Content="Nastavenia" Padding="14,6" Click="TlacidloNastavenia_Click" />
                <Button x:Name="TlacidloAktualizacie" Content="Aktualizácie" Padding="14,6" Margin="8,0,0,0"
                        Click="TlacidloAktualizacie_Click" />
                <Button x:Name="TlacidloOPrograme" Content="O programe" Margin="8,0,0,0" Padding="14,6"
                        Click="TlacidloOPrograme_Click" />
            </StackPanel>
        </Grid>

        <!-- notice bar: a disk of the library was connected -->
        <Border Grid.Row="1" x:Name="Oznam" Visibility="Collapsed" Margin="12,0,12,8" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Ikony}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" x:Name="OznamText" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" x:Name="OznamAkcia" Content="Aktualizovať" Padding="14,4" Margin="12,0,0,0" Click="OznamAkcia_Click" />
                <Button Grid.Column="3" x:Name="OznamZavriet" Content="Neskôr" Padding="14,4" Margin="8,0,0,0" Click="OznamZavriet_Click" />
            </Grid>
        </Border>

        <!-- three columns: navigation, then the detail (a third of the rest) and the library – the detail on the left by
             default, on the right by the settings (owner, 8. 11. 2026); each block has its own tint -->
        <Grid Grid.Row="2" x:Name="Stlpce">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition x:Name="StlpecA" Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="StlpecB" Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,1,1,0" Background="{DynamicResource FarbaMenu}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="KNIŽNICA" Style="{StaticResource NadpisSekcie}" />
                        <ListBox x:Name="NavigaciaKniznica" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="Navigacia_SelectionChanged">
                            <ListBoxItem x:Name="NavigaciaFilmy" Content="Filmy" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaSerialy" Content="Seriály" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaNaPotvrdenie" Content="Na potvrdenie" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaZelane" Content="Zoznam želaní" Style="{StaticResource PolozkaNavigacie}" />
                        </ListBox>

                        <Grid Margin="0,0,8,0">
                            <TextBlock Text="DISKY" Style="{StaticResource NadpisSekcie}" />
                            <Button x:Name="TlacidloPridatDisk" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,2"
                                    Margin="0,0,0,2" Click="PridatDisk_Click" ToolTip="Pridať disk alebo priečinok do katalógu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Ikony}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="Pridať disk" Margin="6,0,0,0" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ZiadnyDisk" Text="Zatiaľ žiadny disk. Pridaj prvý tlačidlom „Pridať disk“."
                                   Margin="12,2,12,4" Style="{StaticResource TichyText}" />
                        <TreeView x:Name="StromDiskov" BorderThickness="0" Background="Transparent" Margin="4,0,4,0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectedItemChanged="StromDiskov_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="StromDiskov_PreviewMouseRightButtonDown">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding Otvoreny, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding Vybraty, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Deti}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nazov}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Popis}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding MaPopis, Converter={StaticResource BoolNaViditelnost}}" />
                                        </StackPanel>
                                        <Ellipse Width="8" Height="8" Fill="#2EA043" Margin="8,0,0,0" VerticalAlignment="Center"
                                                 ToolTip="Disk je pripojený"
                                                 Visibility="{Binding Pripojeny, Converter={StaticResource BoolNaViditelnost}}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ContextMenu>
                                <ContextMenu x:Name="PonukaStromu" Opened="PonukaStromu_Opened">
                                    <MenuItem x:Name="PonukaPrehrat" Header="Prehrať" Click="PrehratZoStromu_Click"
                                              ToolTip="Blu-ray alebo DVD v priečinku, inak videá priečinka ako playlist" />
                                    <Separator />
                                    <MenuItem x:Name="PonukaAktualizovat" Header="Aktualizovať disk" Click="AktualizovatDisk_Click" />
                                    <MenuItem x:Name="PonukaCitat" Header="Prečítať technické údaje videí" Click="CitatTechnickeUdaje_Click"
                                              ToolTip="Rozlíšenie, kodeky, zvuk a titulky s jazykmi, HDR a náhľad – pre videá, ktoré ich ešte nemajú" />
                                    <MenuItem x:Name="PonukaOtvorit" Header="Otvoriť v Prieskumníkovi" Click="OtvoritVPrieskumnikovi_Click" />
                                    <MenuItem x:Name="PonukaUpravit" Header="Upraviť disk…" Click="UpravitDisk_Click" />
                                    <MenuItem x:Name="PonukaOdstranit" Header="Odstrániť disk z knižnice…" Click="OdstranitDisk_Click" />
                                    <Separator />
                                    <MenuItem x:Name="PonukaStitky" Header="Tlačiť štítky…" Click="StitkyZoStromu_Click"
                                              ToolTip="Štítok s QR kódom na disk (pri katalógu na všetky jeho disky)" />
                                    <MenuItem x:Name="PonukaPozicat" Header="Požičať disk…" Click="PozicatDisk_Click" />
                                    <Separator />
                                    <MenuItem Header="Pridať disk…" Click="PridatDisk_Click" />
                                    <MenuItem Header="Nový katalóg…" Click="NovyKatalog_Click" />
                                    <MenuItem x:Name="PonukaPremenovatKatalog" Header="Premenovať katalóg…" Click="PremenovatKatalog_Click" />
                                    <MenuItem x:Name="PonukaZmazatKatalog" Header="Zmazať katalóg…" Click="ZmazatKatalog_Click" />
                                    <MenuItem x:Name="PonukaExportovatKatalog" Header="Exportovať katalóg…" Click="ExportovatKatalog_Click"
                                              ToolTip="Katalóg do samostatného súboru: disky, súbory a tituly na nich (napr. pre iný počítač)" />
                                    <MenuItem Header="Importovať katalóg…" Click="ImportovatKatalog_Click"
                                              ToolTip="Katalógy zo súboru knižnice; disky, ktoré knižnica už má, sa vynechajú" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <TextBlock Text="ZBIERKY" Style="{StaticResource NadpisSekcie}" />
                        <ListBox x:Name="NavigaciaZbierky" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="Navigacia_SelectionChanged">
                            <ListBoxItem x:Name="NavigaciaUlozene" Content="Uložené hľadania" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaKolekcie" Content="Kolekcie" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaStitky" Content="Štítky" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaHistra" Content="Zoznamy HISTRA" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaPlaylisty" Content="Playlisty" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaDuplicity" Content="Duplicity" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaNezalohovane" Content="Len na jednom disku" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaPozicane" Content="Požičané" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaPrehlad" Content="Prehľad diskov" Style="{StaticResource PolozkaNavigacie}" />
                            <ListBoxItem x:Name="NavigaciaStatistiky" Content="Štatistiky" Style="{StaticResource PolozkaNavigacie}" />
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- the library: the poster wall, a disk's folder, results, overviews -->
            <Grid x:Name="PanelStredu" Grid.Column="2">
            <!-- center: an empty state, or the content of a disk's folder -->
            <Grid x:Name="PanelPrazdny" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="NadpisStredu" Text="Filmy" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Ikony}" FontSize="48"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock x:Name="PrazdnyNadpis" Text="Knižnica je zatiaľ prázdna" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,6" TextWrapping="Wrap" />
                    <TextBlock x:Name="PrazdnyText" TextAlignment="Center" Style="{StaticResource TichyText}"
                               Text="Pridaj disk vľavo (Pridať disk). Filmy a seriály z neho sa tu ukážu samy." />
                </StackPanel>
            </Grid>

            <Grid x:Name="PanelSuborov" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="NadpisPriecinka" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" x:Name="PopisPriecinka" Margin="0,2,0,0" Style="{StaticResource TichyText}" />
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="TlacidloHore" Padding="10,5" Click="Hore_Click" ToolTip="O priečinok vyššie">
                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource Ikony}" />
                    </Button>
                    <Button x:Name="TlacidloAktualizovatDisk" Content="Aktualizovať disk" Padding="14,5" Margin="8,0,0,0"
                            Click="AktualizovatDisk_Click" />
                    <Button x:Name="TlacidloOtvorit" Content="Otvoriť v Prieskumníkovi" Padding="14,5" Margin="8,0,0,0"
                            Click="OtvoritVPrieskumnikovi_Click" />
                    <Button Content="Exportovať…" Padding="14,5" Margin="8,0,0,0" Click="ExportovatPriecinok_Click"
                            ToolTip="Obsah priečinka do Excelu, CSV, HTML alebo PDF" />
                    <CheckBox x:Name="AjZmazane" Content="Ukázať aj zmazané" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="AjZmazane_Changed" Unchecked="AjZmazane_Changed" />
                </WrapPanel>
                <ListView Grid.Row="3" x:Name="ZoznamSuborov" SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ZoznamSuborov_SelectionChanged" MouseDoubleClick="ZoznamSuborov_MouseDoubleClick"
                          KeyDown="ZoznamSuborov_KeyDown" SizeChanged="ZoznamSuborov_SizeChanged">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Prehrať" Click="PrehratVybrane_Click" InputGestureText="Enter" />
                            <MenuItem Header="Otvoriť v Prieskumníkovi" Click="OtvoritVPrieskumnikovi_Click" />
                            <MenuItem Header="Kopírovať cestu" Click="KopirovatCestu_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="StlpecNazov" Header="Názov" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding Priehladnost}">
                                            <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nazov}" TextDecorations="{Binding Preciarknutie}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="StlpecVelkost" Header="Veľkosť" Width="90" DisplayMemberBinding="{Binding VelkostText}" />
                            <GridViewColumn x:Name="StlpecZmenene" Header="Zmenené" Width="130" DisplayMemberBinding="{Binding ZmeneneText}" />
                            <GridViewColumn x:Name="StlpecTyp" Header="Typ" Width="80" DisplayMemberBinding="{Binding Typ}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- center: results of a search -->
            <Grid x:Name="PanelVysledkov" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Hľadanie" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" x:Name="PopisVysledkov" Margin="0,2,0,0" Style="{StaticResource TichyText}" />
                <TextBlock Grid.Row="2" x:Name="UpozorneniaHladania" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="TlacidloPrehrat" Padding="14,5" Click="PrehratVybrane_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                            <TextBlock Text="Prehrať" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Content="Uložiť hľadanie…" Padding="14,5" Margin="8,0,0,0" Click="UlozitHladanie_Click" />
                    <Button Content="Exportovať…" Padding="14,5" Margin="8,0,0,0" Click="ExportovatVysledky_Click"
                            ToolTip="Výsledky do Excelu, CSV, HTML alebo PDF" />
                    <Button Content="Tlačiť…" Padding="14,5" Margin="8,0,0,0" Click="TlacitVysledky_Click" />
                    <Button Content="Zavrieť hľadanie" Padding="14,5" Margin="8,0,0,0" Click="ZavrietHladanie_Click" />
                </WrapPanel>
                <ListView Grid.Row="4" x:Name="ZoznamVysledkov" SelectionMode="Extended"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ZoznamVysledkov_SelectionChanged" MouseDoubleClick="ZoznamVysledkov_MouseDoubleClick"
                          KeyDown="ZoznamVysledkov_KeyDown" SizeChanged="ZoznamVysledkov_SizeChanged">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Prehrať" Click="PrehratVybrane_Click" InputGestureText="Enter" />
                            <MenuItem Header="Ukázať v katalógu" Click="UkazatVKatalogu_Click" />
                            <MenuItem Header="Otvoriť v Prieskumníkovi" Click="OtvoritVysledokVPrieskumnikovi_Click" />
                            <MenuItem Header="Kopírovať cestu" Click="KopirovatCestu_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="VysledokNazov" Header="Názov" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding Priehladnost}">
                                            <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nazov}" TextDecorations="{Binding Preciarknutie}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="VysledokDisk" Header="Disk" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DiskPopis}">
                                            <TextBlock Text="{Binding DiskCislo}" />
                                            <Ellipse Width="7" Height="7" Fill="#2EA043" Margin="6,0,0,0" VerticalAlignment="Center"
                                                     Visibility="{Binding Pripojeny, Converter={StaticResource BoolNaViditelnost}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="VysledokCesta" Header="Priečinok" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CestaText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CestaText}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="VysledokVelkost" Header="Veľkosť" Width="90" DisplayMemberBinding="{Binding VelkostText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="4" x:Name="NicSaNenaslo" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Style="{StaticResource TichyText}" MaxWidth="420" />
            </Grid>

            <!-- center: the library of titles – poster wall or list of films, series, collections, HISTRA lists -->
            <Grid x:Name="PanelKniznice" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TlacidloSpatKniznica" Padding="10,5" Margin="0,0,10,0" Click="SpatKniznica_Click" Visibility="Collapsed"
                            ToolTip="Späť">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Ikony}" />
                    </Button>
                    <TextBlock x:Name="NadpisKniznice" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PocetKniznice" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TichyText}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180" MaxWidth="420" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid VerticalAlignment="Top">
                        <TextBox x:Name="FilterKniznice" Padding="8,5" VerticalContentAlignment="Center" TextChanged="FilterKniznice_TextChanged"
                                 ToolTipService.ShowDuration="60000">
                            <TextBox.ToolTip>
                                <TextBlock xml:space="preserve" FontFamily="Consolas" FontSize="12">Slová: názvy titulov (aj originálne, bez ohľadu na diakritiku)
rok:2001   rok:1990..1999   zaner:komedia   hodnotenie:>=7   moje:>=8
herec:"Meno"   rezia:Priezvisko   kolekcia:ano | "Názov"
videne:nie   mam:nie   zelane:ano   kniznica:film | serial | potvrdit
stitok:Vianoce   pozicane:ano | Meno   verzie:>1   zalohovane:nie   rozpozerane:ano
kvalita:4k   zvuk:cs   titulky:sk   disk:3 … podmienky súborov verzií</TextBlock>
                            </TextBox.ToolTip>
                        </TextBox>
                        <TextBlock x:Name="NapovedaFiltraKniznice" Text="Filtrovať, napr. zaner:komedia rok:>=2000" Margin="12,0,8,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="TlacidloNovyPlaylist" Content="Nový playlist…" Padding="14,5" Margin="0,0,8,4" Click="NovyPlaylist_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="TlacidloPrehratPlaylist" Padding="14,5" Margin="0,0,8,4" Click="PrehratPlaylist_Click" Visibility="Collapsed"
                                ToolTip="Celý playlist na pripojených diskoch; seriál hrá ďalšiu nevidenú epizódu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                                <TextBlock Text="Prehrať všetko" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TlacidloZamiesat" Padding="14,5" Margin="0,0,8,4" Click="ZamiesatPlaylist_Click" Visibility="Collapsed"
                                ToolTip="Prehrať v náhodnom poradí">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                                <TextBlock Text="Zamiešať" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TlacidloUlozitNavrh" Content="Uložiť ako playlist" Padding="14,5" Margin="0,0,8,4" Click="UlozitNavrh_Click"
                                Visibility="Collapsed" />
                        <Button x:Name="TlacidloPlaylist" Content="Playlist" Padding="14,5" Margin="0,0,8,4" Click="VystupKniznice_Click" Visibility="Collapsed">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="PonukaUpravitPlaylist" Header="Upraviť…" Click="UpravitPlaylist_Click" />
                                    <MenuItem x:Name="PonukaVylosovat" Header="Vylosovať znova" Click="Vylosovat_Click" />
                                    <MenuItem x:Name="PonukaVyssie" Header="Posunúť vybraný vyššie" Click="PosunutVyssie_Click" />
                                    <MenuItem x:Name="PonukaNizsie" Header="Posunúť vybraný nižšie" Click="PosunutNizsie_Click" />
                                    <MenuItem x:Name="PonukaOdobrat" Header="Odobrať vybraný z playlistu" Click="OdobratZPlaylistu_Click" />
                                    <Separator />
                                    <MenuItem Header="Exportovať ako M3U…" Click="ExportovatM3u_Click"
                                              ToolTip="Zoznam na prehrávanie pre iné programy – súbory na pripojených diskoch" />
                                    <MenuItem x:Name="PonukaZmazatPlaylist" Header="Zmazať playlist…" Click="ZmazatPlaylist_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="TlacidloNahodne" Padding="14,5" Margin="0,0,8,4" Click="NahodnyVyber_Click"
                                ToolTip="Vyber mi niečo: náhodný titul spomedzi zobrazených, ktoré máš (filter platí, napr. videne:nie)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                                <TextBlock Text="Náhodne" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TlacidloPrehratTitul" Padding="14,5" Margin="0,0,0,4" Click="PrehratTitul_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                                <TextBlock Text="Prehrať" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TlacidloNacitatHistra" Content="Načítať zoznamy z HISTRA" Padding="14,5" Margin="8,0,0,4"
                                Click="NacitatHistra_Click" Visibility="Collapsed" />
                        <Button x:Name="TlacidloVystupKniznice" Padding="10,5" Margin="8,0,0,4" Click="VystupKniznice_Click" ToolTip="Export, tlač a štítky">
                            <TextBlock Text="&#xE749;" FontFamily="{StaticResource Ikony}" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Exportovať zoznam…" Click="ExportovatKniznicu_Click" ToolTip="Tituly do Excelu, CSV, HTML alebo PDF" />
                                    <MenuItem Header="Tlačiť zoznam…" Click="TlacitKniznicu_Click" />
                                    <MenuItem Header="Webový katalóg…" Click="WebovyKatalog_Click"
                                              ToolTip="Súkromné stránky celej knižnice do priečinka, zašifrované heslom" />
                                    <MenuItem Header="Štítky titulov…" Click="StitkyTitulov_Click"
                                              ToolTip="Štítky s QR kódom na obaly: vybraný titul, inak všetky zobrazené" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="TlacidloDoplnit" Content="Doplniť údaje" Padding="14,5" Margin="8,0,0,4" Click="Doplnit_Click"
                                ToolTip="Rozpoznať nové videá a doplniť názvy, dej a plagáty zo zdrojov (beží aj samo)" />
                    </WrapPanel>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="UpozornenieKniznice" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                <ListBox Grid.Row="3" x:Name="StenaPlagatov" BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SizeChanged="StenaPlagatov_SizeChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Polozky}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="124" Margin="5" Padding="3" CornerRadius="6" BorderThickness="2" Background="Transparent"
                                                Cursor="Hand" MouseLeftButtonDown="Dlazdica_MouseLeftButtonDown" Opacity="{Binding Priehladnost}"
                                                ToolTip="{Binding Nazov}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Vybrana}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid Height="174">
                                                    <Border CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikony}" FontSize="36" Opacity="0.4"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding Obrazok, IsAsync=True}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4" Padding="6,1" CornerRadius="3"
                                                            Background="#CC202020" Visibility="{Binding MaStitok, Converter={StaticResource BoolNaViditelnost}}">
                                                        <TextBlock Text="{Binding Stitok}" Foreground="White" FontSize="11" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Podnadpis}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListView Grid.Row="3" x:Name="ZoznamTitulov" Visibility="Collapsed"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ZoznamTitulov_SelectionChanged" MouseDoubleClick="ZoznamTitulov_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Názov" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding Priehladnost}">
                                            <TextBlock Text="{Binding Ikona}" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Nazov}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Rok" Width="60" DisplayMemberBinding="{Binding RokText}" />
                            <GridViewColumn Header="Druh" Width="80" DisplayMemberBinding="{Binding DruhText}" />
                            <GridViewColumn Header="Kvalita" Width="70" DisplayMemberBinding="{Binding KvalitaText}" />
                            <GridViewColumn Header="Hodnotenie" Width="90" DisplayMemberBinding="{Binding HodnotenieText}" />
                            <GridViewColumn Header="Stav" Width="120" DisplayMemberBinding="{Binding Stitok}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <TextBlock Grid.Row="3" x:Name="PrazdnaKniznica" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Style="{StaticResource TichyText}" MaxWidth="460" />
            </Grid>

            <!-- center: overview of disks (space, contents, health) and where new files fit (N2) -->
            <Grid x:Name="PanelPrehladu" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Prehľad diskov" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PocetPrehladu" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TichyText}" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,10,0,8" Orientation="Horizontal">
                    <TextBlock Text="Kam sa zmestí" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="PotrebneMiesto" Width="90" Padding="6,4" VerticalContentAlignment="Center" ToolTip="Napr. 50 GB, 700 MB, 1,5 TB" />
                    <Button Content="Nájsť disk" Padding="12,4" Margin="8,0,16,0" Click="KamSaZmesti_Click" />
                    <Button Content="Štítky diskov…" Padding="12,4" Margin="0,0,8,0" Click="StitkyDiskov_Click"
                            ToolTip="Štítky s QR kódom: vybrané disky, inak všetky" />
                    <Button Content="Exportovať…" Padding="12,4" Margin="0,0,8,0" Click="ExportovatPrehlad_Click" />
                    <Button x:Name="TlacidloZdravie" Padding="12,4" Click="ZistitZdravie_Click"
                            ToolTip="Prečíta SMART pripojených diskov; Windows sa opýta na povolenie (číta sa s právami správcu, v samostatnom malom programe)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                            <TextBlock Text="Zistiť zdravie diskov" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock Grid.Row="2" x:Name="VysledokPrehladu" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed" />
                <ListView Grid.Row="3" x:Name="ZoznamPrehladu" SelectionMode="Extended" SelectionChanged="ZoznamPrehladu_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Disk" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="#2EA043" VerticalAlignment="Center"
                                                     Visibility="{Binding Pripojeny, Converter={StaticResource BoolNaViditelnost}}" />
                                            <TextBlock Text="{Binding Nazov}" FontWeight="{Binding Vaha}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Katalóg" Width="100" DisplayMemberBinding="{Binding Katalog}" />
                            <GridViewColumn Header="Obsadené" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid Width="150" Height="6" HorizontalAlignment="Left">
                                                <Border CornerRadius="3" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Border CornerRadius="3" HorizontalAlignment="Left" Width="{Binding SirkaObsadene}"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding MiestoText}" FontSize="11" Opacity="0.75" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Súbory" Width="70" DisplayMemberBinding="{Binding SuboryText}" />
                            <GridViewColumn Header="Tituly" Width="60" DisplayMemberBinding="{Binding TitulyText}" />
                            <GridViewColumn Header="Len tu" Width="60" DisplayMemberBinding="{Binding LenTuText}" />
                            <GridViewColumn Header="Posledný sken" Width="110" DisplayMemberBinding="{Binding SkenText}" />
                            <GridViewColumn Header="Zdravie" Width="170" DisplayMemberBinding="{Binding ZdravieText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- center: statistics of the library (N5) -->
            <ScrollViewer x:Name="PanelStatistik" Margin="20,16,8,8" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Štatistiky" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="SuhrnStatistik" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="15" />
                    <ItemsControl x:Name="SekcieStatistik" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{Binding Nadpis}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Riadky}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Nazov}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Border Height="12" Width="{Binding Sirka}" CornerRadius="2" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PocetText}" Margin="8,0,0,0" FontSize="12" Opacity="0.8" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- center: loans (N6) -->
            <Grid x:Name="PanelVypoziciek" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Požičané" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="PocetVypoziciek" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TichyText}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="0,2,0,0" Style="{StaticResource TichyText}"
                           Text="Disk požičiaš v strome diskov (pravým tlačidlom), titul v jeho detaile. Hľadanie: pozicane:ano alebo pozicane:Meno." />
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="TlacidloVratit" Content="Vrátené" Padding="14,5" Click="VratitVypozicku_Click" IsEnabled="False" />
                    <Button x:Name="TlacidloZmazatVypozicku" Content="Zmazať záznam" Padding="14,5" Margin="8,0,0,0" Click="ZmazatVypozicku_Click" IsEnabled="False" />
                    <Button Content="Exportovať…" Padding="14,5" Margin="8,0,0,0" Click="ExportovatVypozicky_Click" />
                    <CheckBox x:Name="AjVratene" Content="Aj vrátené" Margin="16,0,0,0" VerticalAlignment="Center"
                              Checked="AjVratene_Changed" Unchecked="AjVratene_Changed" />
                </WrapPanel>
                <ListView Grid.Row="3" x:Name="ZoznamVypoziciek" SelectionMode="Extended" SelectionChanged="ZoznamVypoziciek_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Čo" Width="260" DisplayMemberBinding="{Binding Co}" />
                            <GridViewColumn Header="Komu" Width="160" DisplayMemberBinding="{Binding Komu}" />
                            <GridViewColumn Header="Od" Width="100" DisplayMemberBinding="{Binding OdText}" />
                            <GridViewColumn Header="Vrátené" Width="100" DisplayMemberBinding="{Binding DoText}" />
                            <GridViewColumn Header="Poznámka" Width="200" DisplayMemberBinding="{Binding Poznamka}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="3" x:Name="ZiadnaVypozicka" Text="Nič nie je požičané." Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TichyText}" />
            </Grid>

            <!-- center: saved searches -->
            <Grid x:Name="PanelUlozenych" Margin="20,16,20,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Uložené hľadania" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Margin="0,2,0,0" Style="{StaticResource TichyText}"
                           Text="Hľadanie uložíš tlačidlom „Uložiť hľadanie…“ nad jeho výsledkami. Dvojklik ho spustí." />
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,8">
                    <Button x:Name="TlacidloSpustitUlozene" Content="Spustiť" Padding="14,5" Click="SpustitUlozene_Click" />
                    <Button x:Name="TlacidloPremenovatUlozene" Content="Premenovať…" Padding="14,5" Margin="8,0,0,0" Click="PremenovatUlozene_Click" />
                    <Button x:Name="TlacidloZmazatUlozene" Content="Zmazať" Padding="14,5" Margin="8,0,0,0" Click="ZmazatUlozene_Click" />
                </WrapPanel>
                <ListBox Grid.Row="3" x:Name="ZoznamUlozenych" Background="Transparent" BorderThickness="0" MouseDoubleClick="SpustitUlozene_Click" SelectionChanged="ZoznamUlozenych_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Nazov}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Dotaz}" FontFamily="Consolas" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" x:Name="ZiadneUlozene" Text="Zatiaľ žiadne uložené hľadanie." Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TichyText}" />
            </Grid>

            </Grid>

            <Border x:Name="PanelDetailu" Grid.Column="1" BorderThickness="0,1,1,0" Padding="18,16,10,16" Background="{DynamicResource FarbaDetailu}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Top" Click="ZavrietDetail_Click"
                                ToolTip="Zavrieť detail – plagáty na celú šírku (Esc)" />
                        <TextBlock x:Name="DetailNadpis" Text="Detail titulu" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <Image x:Name="DetailNahlad" Margin="0,10,10,0" MaxHeight="200" Stretch="Uniform" HorizontalAlignment="Stretch"
                           Visibility="Collapsed" />
                    <TextBlock x:Name="DetailPrazdny" Margin="0,8,0,0" Style="{StaticResource TichyText}"
                               Text="Vyber titul alebo súbor. Tu uvidíš plagát, dej, kde leží (disk, cesta, či je pripojený), technické údaje, zvuk a titulky s jazykmi a ďalšie verzie na iných diskoch." />
                    <!-- the detail of a title (stage E4) -->
                    <StackPanel x:Name="PanelDetailuTitulu" Visibility="Collapsed">
                        <!-- the card of a title, as in UNIVERSUM (owner, 8. 11. 2026): poster, links, identifiers, names, facts -->
                        <Image x:Name="DetailPlagat" Margin="0,4,0,0" MaxHeight="360" MaxWidth="240" Stretch="Uniform" HorizontalAlignment="Left" />
                        <ItemsControl x:Name="DetailOdkazy" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Text}" ToolTip="{Binding Adresa}" Padding="10,3" Margin="0,0,6,6" Click="OdkazTitulu_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="DetailBlokIdentifikatorov" Background="{DynamicResource FarbaBlokuDetailu}" CornerRadius="6" Padding="10,4,10,8" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Identifikátory" Style="{StaticResource NadpisKarty}" Margin="0,4,0,4" />
                                <ItemsControl x:Name="DetailIdentifikatory" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,1,10,1">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Popis}" Style="{StaticResource TichyText}" Width="58" />
                                                <TextBox Text="{Binding Hodnota, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="DetailHlavnyNazov" Style="{StaticResource TextNaKopirovanie}" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ItemsControl x:Name="DetailIneNazvy" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" FontSize="15" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="DetailPodnadpis" Style="{StaticResource TextNaKopirovanie}" Margin="0,6,0,0" />
                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="DetailPrehrat" Padding="12,4" Margin="0,0,6,6" Click="PrehratTitul_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Ikony}" VerticalAlignment="Center" />
                                    <TextBlock Text="Prehrať" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <ToggleButton x:Name="DetailVidene" Content="Videné" Padding="12,4" Margin="0,0,6,6" Click="DetailVidene_Click" />
                            <ToggleButton x:Name="DetailZelane" Content="Želané" Padding="12,4" Margin="0,0,6,6" Click="DetailZelane_Click" />
                            <Button Content="Upraviť…" Padding="12,4" Margin="0,0,6,6" Click="UpravitTitul_Click" />
                            <Button Content="Štítky…" Padding="12,4" Margin="0,0,6,6" Click="StitkyTitulu_Click"
                                    ToolTip="Vlastné štítky titulu (napr. Vianoce, Pre deti), oddelené čiarkou" />
                            <Button x:Name="DetailPozicat" Content="Požičať…" Padding="12,4" Margin="0,0,6,6" Click="PozicatTitul_Click" />
                            <Button x:Name="DetailZmenitPlagat" Content="Plagát…" Padding="12,4" Margin="0,0,6,6" Click="ZmenitPlagat_Click"
                                    ToolTip="Vybrať iný plagát z TMDB" />
                            <Button x:Name="DetailDoPlaylistu" Content="Do playlistu…" Padding="12,4" Margin="0,0,6,6" Click="DoPlaylistu_Click"
                                    ToolTip="Pridať titul do ručného playlistu (alebo do nového)" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Moje hodnotenie" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="DetailMojeHodnotenie" Width="70" SelectionChanged="DetailMojeHodnotenie_SelectionChanged" />
                        </StackPanel>

                        <ItemsControl x:Name="DetailUdaje" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2,0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Popis}" FontWeight="SemiBold" Width="78" />
                                        <TextBox Text="{Binding Hodnota, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox x:Name="DetailDej" Style="{StaticResource TextNaKopirovanie}" Margin="0,10,0,0" />
                        <!-- choosing what a title is: the candidates of the sources side by side -->
                        <StackPanel x:Name="DetailVyber" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock x:Name="DetailVyberNadpis" Text="Čo je to za titul?" FontWeight="SemiBold" />
                            <TextBlock x:Name="DetailVyberText" Margin="0,2,0,6" Style="{StaticResource TichyText}" FontSize="12" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DetailHladanie" Padding="6,4" VerticalContentAlignment="Center" KeyDown="DetailHladanie_KeyDown"
                                         ToolTipService.ShowDuration="60000">
                                    <TextBox.ToolTip>
                                        <TextBlock xml:space="preserve">Názov a rok:        Carrie 1976   alebo   Carrie (1976)
Réžia:              rezia:Brian De Palma   (aj s názvom: Carrie rezia:De Palma)
TMDB ID:            tmdb:1271   tmdb:tv/1973   alebo odkaz zo stránky themoviedb.org
ID titul hneď potvrdí, ostatné ukážu návrhy.</TextBlock>
                                    </TextBox.ToolTip>
                                </TextBox>
                                <Button Grid.Column="1" Content="Hľadať" Padding="10,3" Margin="6,0,0,0" Click="HladatKandidatov_Click" />
                            </Grid>
                            <ItemsControl x:Name="DetailKandidati">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="132" Margin="0,0,8,8" Padding="4" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <StackPanel>
                                                <Border Height="180" CornerRadius="4" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{Binding Plagat}" Stretch="UniformToFill" />
                                                </Border>
                                                <!-- read-only boxes: the name and year can be selected and copied -->
                                                <TextBox Text="{Binding Nazov, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" FontWeight="SemiBold" Margin="0,4,0,0" MaxHeight="44" />
                                                <TextBox Text="{Binding Podnadpis, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" FontSize="11" Opacity="0.7" />
                                                <TextBlock FontSize="11" Margin="0,2,0,0" Visibility="{Binding MaOdkaz, Converter={StaticResource BoolNaViditelnost}}"
                                                           ToolTip="{Binding Odkaz}">
                                                    <Hyperlink NavigateUri="{Binding Odkaz}" RequestNavigate="OdkazKandidata_RequestNavigate"><Run Text="{Binding OdkazText, Mode=OneWay}" /></Hyperlink>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Margin="0,2,0,0" Visibility="{Binding MaOdkaz, Converter={StaticResource BoolNaViditelnost}}"
                                                           ToolTip="Vybrať iný plagát z TMDB (slovenský, český, anglický, bez textu)">
                                                    <Hyperlink Click="InyPlagatKandidata_Click"><Run Text="{Binding PlagatText, Mode=OneWay}" /></Hyperlink>
                                                </TextBlock>
                                                <Button Content="Toto je ono" Margin="0,6,0,0" Padding="8,3" Click="VybratKandidata_Click" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="DetailPotvrdit" Content="Potvrdiť, ako je" Padding="10,3" Margin="0,0,6,6" Click="PotvrditTitul_Click" />
                                <Button Content="Nie je to film ani seriál" Padding="10,3" Margin="0,0,6,6" Click="NieJeTitul_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- where the title lies: each version with its disk and what its file is (picture, sound, subtitles) -->
                        <ItemsControl x:Name="DetailVerzie" Margin="0,12,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource FarbaBlokuDetailu}" CornerRadius="6" Padding="10,4,10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nadpis}" Style="{StaticResource NadpisKarty}" Margin="0,4,0,2" />
                                            <TextBox Text="{Binding Kde, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" />
                                            <ItemsControl ItemsSource="{Binding Riadky}" Margin="0,4,0,0" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,2,0,0">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Popis}" Style="{StaticResource TichyText}" Width="78" />
                                                            <TextBox Text="{Binding Hodnota, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Expander Header="Všetky podrobnosti súboru" Margin="0,6,0,0" FontWeight="SemiBold"
                                                      Visibility="{Binding MaPodrobnosti, Converter={StaticResource BoolNaViditelnost}}">
                                                <local:PodrobnostiSuboru Sekcie="{Binding Podrobnosti}" Margin="0,6,0,0" FontWeight="Normal" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ItemsControl x:Name="DetailRiadky" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Popis}" FontSize="11" Opacity="0.7" />
                                    <TextBox Text="{Binding Hodnota, Mode=OneWay}" Style="{StaticResource TextNaKopirovanie}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- the details of a video file as MediaInfo shows them (KATALOG's own reader of MKV and MP4) -->
                    <StackPanel x:Name="DetailPodrobnostiPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Text="Podrobnosti súboru" Style="{StaticResource NadpisKarty}" FontSize="15" />
                        <local:PodrobnostiSuboru x:Name="DetailPodrobnosti" />
                    </StackPanel>
                    <!-- all titles of the title's collections, small posters: a click opens the title (owner, 8. 11. 2026) -->
                    <ItemsControl x:Name="DetailKolekcie" Visibility="Collapsed" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FarbaKolekcie}" BorderBrush="{DynamicResource FarbaKolekcieOkraj}" BorderThickness="3,0,0,0"
                                        CornerRadius="6" Padding="10,4,10,4" Margin="0,4,0,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource NadpisKarty}" Foreground="{DynamicResource FarbaKolekcieOkraj}" FontSize="15"
                                                   Margin="0,4,0,6" TextWrapping="Wrap">
                                            <Run Text="Kolekcia: " /><Run Text="{Binding Nazov, Mode=OneWay}" /><Run Text="{Binding Pocet, Mode=OneWay}" FontWeight="Normal" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Diely}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button ToolTip="{Binding Popis}" Margin="0,0,8,8" Cursor="Hand" Click="DielKolekcie_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <StackPanel Width="72" Opacity="{Binding Priehladnost}">
                                                                    <Border x:Name="Ram" Width="72" Height="108" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent"
                                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding Nazov}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="3" />
                                                                            <Image Source="{Binding Obrazok, IsAsync=True}" Stretch="UniformToFill" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Popis}" FontSize="11" TextWrapping="Wrap" MaxHeight="30" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Aktualny}" Value="True">
                                                                        <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Ram" Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- status line: library, background jobs, version -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="12,6"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StavKniznice" Text="Otváram knižnicu…" Style="{StaticResource TichyText}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="StavUloh" Text="Fronta úloh: prázdna" Margin="16,0,8,0"
                           Style="{StaticResource TichyText}" VerticalAlignment="Center" TextWrapping="NoWrap" />
                <ProgressBar Grid.Column="2" x:Name="PriebehSkenu" Width="160" Height="6" Visibility="Collapsed"
                             VerticalAlignment="Center" Minimum="0" Maximum="100" />
                <Button Grid.Column="3" x:Name="TlacidloZrusitSken" Content="Zastaviť" Padding="10,2" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="ZrusitSken_Click" />
                <TextBlock Grid.Column="4" x:Name="StavVerzie" Margin="16,0,0,0" Style="{StaticResource TichyText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
